# Copy to .env for local runs. For GitHub Actions, set these as repository
# Secrets instead (Settings > Secrets and variables > Actions).

# Resume: set CV_URL to a hosted PDF/DOCX, or leave it empty and drop a
# .pdf/.docx file into the cv/ folder instead (local runs only).
CV_URL=

# Telegram bot: message @BotFather, run /newbot to get a token, then message
# your bot once and open https://api.telegram.org/bot<TOKEN>/getUpdates to
# read your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
